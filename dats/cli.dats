# End-to-end tests of the overview binary against a small git repository.

sandbox:
	image: golang:1.25

shared:
	files:
		repo/main.go: |
			// Command demo prints things. More text.
			package main
		repo/gen.go: |
			// Code generated by hand-tool. DO NOT EDIT.
			package main
		repo/LICENSE: |
			MIT
		repo/notes.md: |
			# Notes
		repo/src/ui/feed.ts: |
			/** <feed> — a log table. */
			export {};
		repo/src/ui/feed.test.ts: |
			import { feed } from './feed.ts';
		repo/.gitignore: |
			ignored.go
		repo/ignored.go: |
			// Package ignored never shows.
			package main
setup:
	- cp "$GO_TOOLCHAIN_DATS_BUILD_DIR/overview" {shared.overview}
	- cd "$(dirname {shared.repo/main.go})" && git init -q && git add -A

tests:
	- desc: the tree shows each summary, directories first, ignored files absent
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview}
	  outputs:
		stdout:
			0: '^├── src/$'
			1: '^│   └── ui/$'
			2: '^│       ├── feed\.test\.ts$'
			3: '^│       └── feed\.ts  ← <feed> — a log table\.$'
			4: '^├── \.gitignore$'
			5: '^├── LICENSE$'
			6: '^├── gen\.go    ← Code generated by hand-tool\.$'
			7: '^├── main\.go   ← Command demo prints things\.$'
			8: '^└── notes\.md  ← Notes$'
		!stdout:
			- ignored.go
			- More text

	- desc: --depth folds a directory into its file count
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} --depth 1
	  outputs:
		stdout:
			0: '^├── src/ \(2 files\)$'
		!stdout:
			- feed.ts

	- desc: a path argument limits the tree
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} src
	  outputs:
		stdout:
			- feed.ts
		!stdout:
			- main.go

	- desc: check names each file with no header and fails
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} check
	  exit: 1
	  outputs:
		stdout:
			- "src/ui/feed.test.ts: no header comment"
		stderr:
			- "overview: 1 of 4 files have no header comment"
		!stdout:
			- gen.go

	- desc: check passes once the headerless file is excluded by base name
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} check --exclude '*.test.ts'
	  outputs:
		stdout:
			- "3 files checked, every one has a header comment"

	- desc: an exclude with a trailing slash skips a directory
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} check --exclude src/
	  outputs:
		stdout:
			- "2 files checked, every one has a header comment"

	- desc: a malformed exclude glob is an error, not a silent no-match
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} check --exclude '['
	  exit: 1
	  outputs:
		stderr:
			- "syntax error in pattern"

	- desc: this repository passes its own check
	  cmd: "{shared.overview} check --exclude '*_test.go' --exclude testdata/"
	  outputs:
		stdout:
			- "every one has a header comment"

	- desc: outside a git work tree it fails and names git
	  cmd: cd "$(mktemp -d)" && {shared.overview}
	  exit: 1
	  outputs:
		stderr:
			- "overview: git ls-files"
