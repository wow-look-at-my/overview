# End-to-end tests of the overview binary against a small git repository.

sandbox:
	image: golang:1.25

shared:
	files:
		repo/main.go: |
			// Command demo prints things. More text.
			package main
		repo/gen.go: |
			// Code generated by hand-tool. DO NOT EDIT.
			package main
		repo/LICENSE: |
			MIT
		repo/notes.md: |
			# Notes
		repo/src/ui/feed.ts: |
			/** <feed> — a log table. */
			export {};
		repo/src/ui/feed.test.ts: |
			import { feed } from './feed.ts';
		repo/.gitignore: |
			ignored.go
		repo/ignored.go: |
			// Package ignored never shows.
			package main
setup:
	- cp "$GO_TOOLCHAIN_DATS_BUILD_DIR/overview" {shared.overview}
	- cd "$(dirname {shared.repo/main.go})" && git init -q && git add -A

tests:
	- desc: one sorted full path per line with its summary, ignored files absent
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview}
	  outputs:
		stdout:
			0: '^\.gitignore$'
			1: '^LICENSE$'
			2: '^gen\.go  ← Code generated by hand-tool\.$'
			3: '^main\.go  ← Command demo prints things\.$'
			4: '^notes\.md  ← Notes$'
			5: '^src/ui/feed\.test\.ts$'
			6: '^src/ui/feed\.ts  ← <feed> — a log table\.$'
		!stdout:
			- ignored.go
			- More text

	- desc: the tree flags are gone
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} --depth 1
	  exit: 1
	  outputs:
		stderr:
			- "unknown flag: --depth"

	- desc: a path argument limits the list
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} src
	  outputs:
		stdout:
			- feed.ts
		!stdout:
			- main.go

	- desc: there is no check subcommand, so the word is read as a path that matches nothing
	  cmd: cd "$(dirname {shared.repo/main.go})" && {shared.overview} check
	  outputs:
		!stdout:
			- main.go
			- no header comment

	- desc: outside a git work tree it fails and names git
	  cmd: cd "$(mktemp -d)" && {shared.overview}
	  exit: 1
	  outputs:
		stderr:
			- "overview: git ls-files"
